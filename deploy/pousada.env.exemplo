# Copie para /etc/pousada.env  (sudo cp deploy/pousada.env.exemplo /etc/pousada.env)
# e proteja:  sudo chown root:root /etc/pousada.env && sudo chmod 600 /etc/pousada.env
POUSADA_PRODUCAO=1
POUSADA_HTTPS=1
POUSADA_PROXY=1
POUSADA_HOST=127.0.0.1
POUSADA_PORTA=5000
TRUSTED_HOSTS=reservapousadaboaesperanca.com.br,www.reservapousadaboaesperanca.com.br
POUSADA_DB=/var/lib/pousada/reservas.db
POUSADA_BACKUP_DIR=/var/lib/pousada/backups
POUSADA_INSTANCIA=/var/lib/pousada/instance
POUSADA_LOG_DIR=/var/log/pousada
# Gere com:  python3 -c "import secrets;print(secrets.token_hex(32))"
POUSADA_SECRET_KEY=COLE-AQUI-A-CHAVE-GERADA
